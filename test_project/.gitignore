# Keil MDK build output. The .axf/.hex and the ~60 object files are regenerated
# by `UV4 -b MDK-ARM/test_project.uvprojx`; only the project files and the small
# generated headers above are worth keeping.
MDK-ARM/test_project/
MDK-ARM/*.lst
MDK-ARM/*.htm
*.build_log.htm
build.log
*.uvguix.*
*.scvd

# Keil's RTE manager regenerates this from the .uvprojx on every build. Verified
# by deleting it: `UV4 -r` recreates it and still reports 0 errors. Keeping it
# tracked means every build shows a spurious modification, because Keil rewrites
# it with CRLF while the repository stores LF.
MDK-ARM/RTE/

# CMake / GCC build output
build/
cmake-build-*/
CMakeUserPresets.json

{
  "name": "jlink-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that drives a SEGGER J-Link probe to debug microcontrollers: flash, halt/resume, memory and register access.",
  "type": "module",
  "bin": {
    "jlink-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2"
  }
}
